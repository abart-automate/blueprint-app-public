#!/bin/sh
# Optional local pre-commit check: runs the TypeScript typecheck so type errors
# are caught before they reach CI. Enable once per clone with:
#
#   git config core.hooksPath scripts/git-hooks
#
# Nothing depends on this hook any more. sw.js's SW_BUILD stamp is applied at
# build time by vite.config.mjs (see the comment above SW_BUILD in sw.js), and
# CI runs the same typecheck before deploying, so a clone without the hook
# still ships correct builds.

repo_root="$(git rev-parse --show-toplevel)"

# Skipped entirely — with a warning, not a hard failure — on a fresh clone that
# hasn't run `npm install` yet, so this hook never blocks on network access.
if [ -f "$repo_root/node_modules/.bin/tsc" ]; then
  if ! "$repo_root/node_modules/.bin/tsc" --noEmit -p "$repo_root"; then
    echo "pre-commit: TypeScript check failed (tsc --noEmit). Fix the errors above, or use 'git commit --no-verify' to bypass intentionally." >&2
    exit 1
  fi
else
  echo "pre-commit: TypeScript not installed (run 'npm install') — skipping typecheck." >&2
fi
